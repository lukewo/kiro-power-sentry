{
  "name": "sentry-mcp-server",
  "version": "1.2.0",
  "private": true,
  "description": "Read-only local MCP server exposing Sentry REST API read tools for the sentry Kiro Power.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --format=esm --target=node18 --outfile=dist/index.js --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "esbuild": "^0.24.0",
    "zod": "^3.23.8"
  },
  "license": "MIT"
}
